# ============================================================
# AI Chatbot System — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------
# App
# ------------------------------------
APP_NAME="AI Chatbot System"
APP_URL="https://appupili.up.ac.th/cbms"
APP_ENV="production"
APP_DEBUG=false
APP_SECRET_KEY="change-this-to-a-random-64-character-string-before-deploying"
APP_TIMEZONE="Asia/Bangkok"

# ------------------------------------
# Database
# ------------------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_DATABASE="chatbot_db"
DB_USERNAME="chatbot_user"
DB_PASSWORD="your_db_password_here"
DB_CHARSET="utf8mb4"

# ------------------------------------
# OpenRouter AI
# ------------------------------------
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_SITE_URL="https://appupili.up.ac.th/cbms"
OPENROUTER_SITE_NAME="AI Chatbot System - CBMS"
OPENROUTER_DEFAULT_MODEL="openai/gpt-4o-mini"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"

# --- Optional: dedicated embedding endpoint ---
# text-embedding-3-small scores poorly on Thai. To switch to a multilingual
# model, set these (any OpenAI-compatible /embeddings API works — OpenAI
# text-embedding-3-large, Google gemini-embedding-001 via AI Studio's
# OpenAI-compat endpoint, self-hosted BGE-M3, ...) then run:
#     php sync.php --re-embed-all
# Old vectors have a different dimension and score 0 until re-embedded.
# EMBEDDING_MODEL="gemini-embedding-001"
# EMBEDDING_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
# EMBEDDING_API_KEY=""

# Model used by `php sync.php --build-wiki` to rewrite documents into wiki
# pages. Runs rarely and offline, so a stronger (pricier) model than the chat
# default pays off here. Leave empty to reuse the default model.
WIKI_BUILDER_MODEL=""

# ------------------------------------
# Microsoft Office 365 / Azure AD
# ------------------------------------
MICROSOFT_CLIENT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MICROSOFT_CLIENT_SECRET="your-azure-client-secret"
MICROSOFT_TENANT_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
MICROSOFT_REDIRECT_URI="https://appupili.up.ac.th/cbms/admin/auth-callback.php"
# Comma-separated allowed email domains (empty = allow all)
MICROSOFT_ALLOWED_DOMAINS="up.ac.th"

# ------------------------------------
# CAMS API (Permission Verification)
# ------------------------------------
CAMS_API_URL="https://appupili.up.ac.th/cams/api/v1"
CAMS_API_KEY=""
CAMS_PROGRAM_CODE="CBMS"

# ------------------------------------
# Google Drive
# ------------------------------------
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
GOOGLE_DRIVE_FOLDER_ID="your-google-drive-folder-id"

# ------------------------------------
# Facebook Messenger
# ------------------------------------
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_VERIFY_TOKEN="random-verify-token-for-webhook"

# ------------------------------------
# LINE Official Account
# ------------------------------------
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""

# ------------------------------------
# Admin Session
# ------------------------------------
ADMIN_SESSION_NAME="cbms_chatbot_admin"
ADMIN_SESSION_LIFETIME=86400
ALLOW_LOCAL_LOGIN=true

# ------------------------------------
# Rate Limiting
# ------------------------------------
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_HOUR=100

# ------------------------------------
# Answer Cache (semantic FAQ cache — requires migration 007)
# Repeated knowledge questions are answered from cache without
# calling the LLM. Similarity 0.95 = near-exact paraphrases only.
# ------------------------------------
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL_HOURS=72
ANSWER_CACHE_MIN_SIMILARITY=0.95
